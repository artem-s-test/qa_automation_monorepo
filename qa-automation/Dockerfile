# Беремо офіційний образ Playwright — у ньому вже встановлені Node.js,
# Chromium, Firefox і WebKit разом з усіма системними залежностями для них.
# Версія тега (v1.61.1) має збігатися з версією @playwright/test у package.json,
# інакше браузери в образі можуть не підійти до версії тестового фреймворку.
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

# Робоча директорія всередині контейнера — усі наступні команди (COPY, RUN, CMD)
# виконуються відносно неї.
WORKDIR /app

# Спочатку копіюємо лише файли з описом залежностей...
COPY package*.json ./
# ...і встановлюємо їх окремим кроком. Docker кешує кожен крок (шар/layer):
# якщо package.json не змінився, цей крок береться з кешу і не виконується
# заново, що значно прискорює повторні збірки образу.
RUN npm ci

# Тепер копіюємо весь інший код проєкту (тести, page objects, конфіг тощо).
# Цей крок навмисно йде після npm ci, щоб зміни в коді тестів не інвалідовували
# кеш встановлення залежностей.
COPY . .

# Команда, яка виконується при старті контейнера за замовчуванням —
# запускає всі Playwright-тести. Її можна перевизначити при `docker run`,
# передавши свою команду наприкінці (наприклад, щоб запустити лише один файл).
CMD ["npx", "playwright", "test"]
